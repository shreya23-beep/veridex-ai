{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://veridex-engine.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/ui/web/:path*"
    },
    {
      "source": "/",
      "destination": "/ui/web/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/ui/web/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
